# DeepSeek — OpenAI-compatible Chat Completions
# @see https://api-docs.deepseek.com/zh-cn/

# Required for real model calls (omit to use MockAIClient)
DEEPSEEK_API_KEY=

# Opt-in: live DeepSeek tests (honesty e2e + model×thinking smoke)
# JEA_LIVE_DEEPSEEK=1
# JEA_LIVE_DEEPSEEK_DEEP=1   # also run pro×max cells (slower/costlier)
# Then: npm run test:live-deepseek
# API smoke matrix: npm run test:live-deepseek:matrix
# Intel honesty matrix (model×thinking×pipeline): npm run test:live-deepseek:intel-matrix

# Optional (defaults shown)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM profiles (DeepSeek V4): fast=flash+off | balanced=flash+high | deep=pro+max
# Default profile is balanced; phases may map observe→fast, report/decide→balanced, etc.
# JEA_LLM_PROFILE=balanced
# Per-phase override (profile name or shorthand model:thinking):
# JEA_LLM_PHASE_OBSERVE=fast
# JEA_LLM_PHASE_REPORT=flash:high
# JEA_LLM_PHASE_DECIDE=balanced
# JEA_LLM_PHASE_AGENT_LOOP=deep
# JEA_LLM_PHASE_LLM_PING=fast

# Optional: UI/runtime content language (zh-CN | en-US, defaults to zh-CN)
JEA_LANGUAGE=zh-CN

# Optional: device-level Subject state root (default: ~/.jea; Windows: %USERPROFILE%\.jea)
# Relative values are resolved from JEA_PROJECT_ROOT. Shell JEA_HOME overrides this file.
# JEA_HOME=/absolute/path/to/.jea

# Optional: override Cyber-Taoist authority docs directory (default: policies/authority/)
# CYBER_TAOIST_DOCS_DIR=

# Approval policy: manual | auto_guarded | auto_all
# manual keeps current behavior.
# auto_guarded only auto-approves low-risk guard/probe/record actions.
# auto_all auto-approves all approval-gated actions including publish and core_apply (except JEA_CORE_APPLY_POLICY=disabled).
# JEA_APPROVAL_MODE=manual

# Optional: round limit for intel viewer serve/build (defaults to 50)
# JEA_VIEWER_BUILD_LIMIT=50

# -----------------------------------------------------------------------------
# Repo links (js-repolink) — sibling local project roots for lane / external tools
# Declared in repolink.config.mjs; paths stay machine-local and out of git.
# Run `jea doctor` to verify link status and preflight probes.
# -----------------------------------------------------------------------------
# AGENTANK_EVOLVER_PATH=D:/github/My/agentank-evolver

# Optional: daemon evolution mode — continuous (default) | on_demand
# continuous: heartbeat tick auto-queues cycle start requests
# on_demand: only explicit cycle start requests (brief, jea daemon cycle request) open cycles
# JEA_EVOLUTION_MODE=continuous

# Cycle pipeline is reactor-only after S9. --pipeline agent_loop|phases / --loop fail.
# JEA_CYCLE_PIPELINE=reactor
# Optional opt-in leftovers (not train rollback):
# JEA_TICK_OPEN_CYCLE=1
# JEA_STEP_ARTIFACT_RECONCILE=1
# Report-centric investigation turns (used by the reactor cognitive step)
# JEA_LOOP_MAX_READONLY_TURNS=6
# Legacy alias; effective readonly turns = min(MAX_READONLY, MAX_TURNS) when both set
# JEA_LOOP_MAX_TURNS=6
# JEA_LOOP_MAX_WALLCLOCK_MS=1200000
# JEA_LOOP_TOOL_RESULT_MAX_CHARS=6000
# Wallclock reserved for host single-shot report + Analyze+Decide (investigation soft-deadline = total - reserve)
# JEA_LOOP_FINISH_RESERVE_MS=120000
# Timeout (seconds) for forced finish_investigation closing turn
# JEA_LOOP_CLOSING_TIMEOUT_SEC=240
# Auto-archive completed/expired decision queue items at agent_loop start (default on; set 0 to disable)
# JEA_QUEUE_AUTO_ARCHIVE=1

# Optional: default provider for agent_execute / agent_run when action.params.provider is omitted.
# Allowed values: llm_only, claude_code_sdk, cursor_sdk, reasonix_cli, acp:claude-code
JEA_AGENT_PROVIDER=claude_code_sdk

# Legacy thinking overrides (applied under JEA_LLM_PROFILE / phase overrides):
# DEEPSEEK_THINKING=enabled|disabled
# DEEPSEEK_REASONING_EFFORT=high|max
# Prefer JEA_LLM_PROFILE / JEA_LLM_PHASE_* for new setups.

# -----------------------------------------------------------------------------
# Claude Code / Claude Agent SDK — default: DeepSeek Anthropic-compatible API
# Same as CLI setup: https://api-docs.deepseek.com/zh-cn/quick_start/agent_integrations/claude_code
# Use your DeepSeek API key from DeepSeek Platform (Bearer token for Claude Code).
# For first-party Anthropic only, set ANTHROPIC_API_KEY instead and omit or unset ANTHROPIC_BASE_URL below.
# -----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=

# Model lineup (DeepSeek v4 as primary per docs; adjust if your account exposes different IDs)
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max

# Optional: Anthropic Console API key (alternative to ANTHROPIC_AUTH_TOKEN + DeepSeek BASE_URL)
# ANTHROPIC_API_KEY=

# Optional Claude Agent SDK overrides (see src/actions/agent-adapter.mjs)
# CLAUDE_AGENT_MODEL=
# CLAUDE_AGENT_MAX_TURNS=99
# Claude Code filesystem settings (comma-separated): user, project, local
# CLAUDE_AGENT_SETTING_SOURCES=user,project,local
# Default adapter permission is bypassPermissions; tighten with plan|acceptEdits|default etc.
# CLAUDE_AGENT_PERMISSION_MODE=

# -----------------------------------------------------------------------------
# Agent Client Protocol (ACP) stdio provider
# Used when JEA_AGENT_PROVIDER=acp:claude-code or action.params.provider uses acp:*.
# The default remains unchanged. ACP uses the same Anthropic credentials above
# (or the ACP agent's own local login) and enforces permission_profile headlessly.
# -----------------------------------------------------------------------------
# JEA_ACP_CLAUDE_CODE_BIN=claude-agent-acp
# JSON array or whitespace-separated arguments appended to the ACP command.
# JEA_ACP_CLAUDE_CODE_ARGS=
# Per-turn initialize/session/prompt timeout and child shutdown grace.
# JEA_ACP_TIMEOUT_MS=1800000
# JEA_ACP_KILL_GRACE_MS=5000
# Doctor performs an initialize + session/new handshake by default.
# JEA_ACP_DOCTOR_HANDSHAKE=1
# JEA_ACP_DOCTOR_TIMEOUT_MS=5000
# Opt-in real-agent smoke test (skipped by default):
# JEA_LIVE_ACP_CLAUDE_CODE=1

# -----------------------------------------------------------------------------
# Cursor SDK local agent provider
# Used by agent_execute when params.provider=cursor_sdk.
# Create a key from Cursor Dashboard / Cloud Agents.
# -----------------------------------------------------------------------------
CURSOR_API_KEY=
# Local Cursor agents require an explicit model; composer-2 is the adapter default.
# CURSOR_AGENT_MODEL=composer-2
# Ambient Cursor settings layers for local runtime (comma-separated); empty by default.
# Allowed values include project,user,team,mdm,plugins,all.
# CURSOR_AGENT_SETTING_SOURCES=
# Optional: absolute path to rg (ripgrep). Cursor SDK uses it for .gitignore/.cursorignore mapping.
# Example (Homebrew on this machine): /Volumes/home_x/homebrew/bin/rg or $(brew --prefix)/bin/rg
# CURSOR_RIPGREP_PATH=

# -----------------------------------------------------------------------------
# DeepSeek-Reasonix CLI agent provider
# Used when JEA_AGENT_PROVIDER=reasonix_cli or action.params.provider=reasonix_cli.
# Requires the `reasonix` binary on PATH, or set REASONIX_BIN below.
# Reasonix uses DEEPSEEK_API_KEY from this file/environment.
# -----------------------------------------------------------------------------
# REASONIX_BIN=reasonix
# Optional extra args before `run`; mainly useful for tests/wrappers.
# JEA_REASONIX_BIN_ARGS=
# Optional model passed as: reasonix run --model <value> <task>
# JEA_REASONIX_MODEL=deepseek-flash
# CLI flavor auto-detect: npm (0.x from npm) vs go (main-v2). npm requires task as argv;
# go also accepts stdin for oversized prompts. Override with npm|go when needed.
# JEA_REASONIX_FLAVOR=auto
# Optional max tool-call rounds (go/main-v2 only): reasonix run --max-steps <value>
# JEA_REASONIX_MAX_STEPS=25
# Provider-level timeout in milliseconds (default: 30 minutes)
# JEA_REASONIX_TIMEOUT_MS=1800000
# Optional Reasonix config path exposed to the child process as REASONIX_CONFIG.
# Current Reasonix main-v2 does not expose a `run --config` flag, so this is
# metadata/env for wrappers and future compatibility rather than a CLI argument.
# JEA_REASONIX_CONFIG=
# Bash is disabled by host-side constraints by default, especially on Windows.
# Set to 1 only for trusted sandbox/worktree runs.
# JEA_REASONIX_ALLOW_BASH=0

# -----------------------------------------------------------------------------
# Feishu channel adapter (per-subject bots via <JEA_HOME>/subjects/registry.json)
# Prefer app_secret_env in the JEA Home registry; do not commit secrets.
# Replace MY_SUBJECT with the env slug of your subject id (hyphens -> underscores, uppercased).
# Example: subject "my-subject" -> JEA_CHANNEL_FEISHU_MY_SUBJECT_APP_ID, FEISHU_MY_SUBJECT_APP_SECRET, ...
# See policies/subjects.example.json for channels.feishu layout (app_id_env, app_secret_env, bind, etc.).
# -----------------------------------------------------------------------------
# Per-subject credentials (match registry app_id_env / app_secret_env; do not commit secrets):
# JEA_CHANNEL_FEISHU_MY_SUBJECT_APP_ID=cli_REPLACE_WITH_YOUR_APP_ID
# FEISHU_MY_SUBJECT_APP_SECRET=REPLACE_WITH_YOUR_APP_SECRET
# Subject-prefixed overrides (alternative naming; omit if using the vars above):
# JEA_CHANNEL_FEISHU_MY_SUBJECT_APP_SECRET=REPLACE_WITH_YOUR_APP_SECRET
#
# Private DM bind (recommended when default_chat_id is not preset):
# 1) Enable channels.feishu.bind in <JEA_HOME>/subjects/registry.json (see subjects.example.json).
# 2) Set bind.token_env below; start channel worker; DM the bot: JEA BIND <token>
# JEA_CHANNEL_FEISHU_MY_SUBJECT_BIND_TOKEN=choose-a-long-random-token
# Or skip bind and set open_id / group chat_id manually:
# JEA_CHANNEL_FEISHU_MY_SUBJECT_DEFAULT_CHAT_ID=ou_...
#
# Repeat the block above for each subject in the JEA Home registry (one bot per subject).
# Global fallback (single-subject dev only):
# JEA_CHANNEL_FEISHU_APP_ID=
# JEA_CHANNEL_FEISHU_APP_SECRET=
# JEA_CHANNEL_FEISHU_MOCK=1
#
# Bounded Feishu I/O defaults (milliseconds). Per-subject variants insert
# _MY_SUBJECT before the timeout suffix, for example
# JEA_CHANNEL_FEISHU_MY_SUBJECT_SEND_TIMEOUT_MS.
# JEA_CHANNEL_FEISHU_CONNECT_TIMEOUT_MS=20000
# JEA_CHANNEL_FEISHU_SEND_TIMEOUT_MS=30000
# JEA_CHANNEL_FEISHU_STOP_TIMEOUT_MS=5000
# JEA_CHANNEL_SHUTDOWN_GRACE_MS=10000
# Listener supervisor backoff when the SDK is not yet connected.
# Per-subject variants insert _MY_SUBJECT before the suffix.
# JEA_CHANNEL_FEISHU_RETRY_BASE_MS=5000
# JEA_CHANNEL_FEISHU_RETRY_MULTIPLIER=2
# JEA_CHANNEL_FEISHU_RETRY_MAX_MS=300000
# JEA_CHANNEL_FEISHU_RETRY_JITTER=0.2
# Channel agent_run timeout (does not change cycle exec timeouts).
# JEA_CHANNEL_AGENT_TIMEOUT_MS=1800000
