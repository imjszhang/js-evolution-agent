{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@jea/app": ["../../packages/jea-app/src/index.ts"],
      "@jea/app/styles.css": ["../../packages/jea-app/src/styles/index.css"]
    }
  },
  "include": ["src", "electron.vite.config.ts", "test"]
}
