{
  "name": "js-evolution-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A controlled self-evolution host instance with vendored OADA engine (src/engine/) and js-intel-store intelligence memory.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "jea": "src/cli/jea.mjs"
  },
  "scripts": {
    "start": "node --preserve-symlinks src/cli/jea.mjs run",
    "jea": "node --preserve-symlinks src/cli/jea.mjs",
    "doctor": "node --preserve-symlinks src/cli/jea.mjs doctor",
    "reset-data": "node --preserve-symlinks src/cli/jea.mjs data reset --yes",
    "test": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run",
    "check": "node --preserve-symlinks scripts/ci-repo-checks.mjs",
    "reactor:canary": "node --preserve-symlinks scripts/reactor-s0-s9-canary.mjs",
    "test:live-deepseek": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run test/intel-report-honesty-live.test.mjs test/deepseek-model-thinking-live.test.mjs",
    "test:live-deepseek:matrix": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run test/deepseek-model-thinking-live.test.mjs",
    "test:live-deepseek:intel-matrix": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run --pool=forks --maxWorkers=1 test/intel-report-honesty-matrix-live.test.mjs",
    "desktop:dev": "npm run dev --workspace @jea/desktop",
    "desktop:build": "npm run build --workspace @jea/desktop",
    "desktop:test": "npm run test --workspace @jea/desktop",
    "test:client-api": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run apps/desktop/test/client-api",
    "desktop:typecheck": "npm run typecheck --workspace @jea/desktop",
    "app:check": "npm run check --workspace @jea/app",
    "app:test": "npm run test --workspace @jea/app",
    "app:build": "npm run build --workspace @jea/app",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:ci": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=test-artifacts/junit.xml",
    "test:coverage": "node --preserve-symlinks ./node_modules/vitest/vitest.mjs run --coverage",
    "audit:ci": "node --preserve-symlinks scripts/ci-audit.mjs",
    "viewer:build": "node --preserve-symlinks src/cli/jea.mjs intel viewer build",
    "viewer:serve": "node --preserve-symlinks src/cli/jea.mjs intel viewer serve --open",
    "viewer:serve:win": "powershell -ExecutionPolicy Bypass -File scripts/viewer-serve-win.ps1 -Launch",
    "daemon:start:detached": "powershell -ExecutionPolicy Bypass -File scripts/daemon-start-detached-win.ps1"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.68.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.232",
    "@cursor/sdk": "^1.0.28",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "js-intel-store": "^0.1.0",
    "js-repolink": "^0.1.0",
    "js-traceability": "^0.1.0",
    "openai": "^7.4.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "marked": "^18.0.9",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34",
    "ip-address": "^10.5.0"
  },
  "license": "MIT"
}
