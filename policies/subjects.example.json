{
  "default_subject": "my-subject",
  "subjects": {
    "my-subject": {
      "policy": "SUBJECT.md",
      "data_namespace": "my-subject",
      "evolution": {
        "state": "active",
        "automation": "automatic",
        "mode": "on_demand",
        "pipeline": "reactor",
        "guards": [
          {
            "id": "example-credential-sync",
            "enabled": false,
            "every_cycles": 1,
            "action": {
              "type": "lane_status",
              "description": "Mechanical guard example: check lane health each cycle",
              "priority": "high",
              "params": {}
            }
          }
        ]
      },
      "approval": {
        "sensitive_keywords": [
          "example-subject-specific-endpoint"
        ]
      },
      "lane": {
        "repo": "link:my-target-project",
        "base_branch": "main",
        "lane_branch": "jea/my-subject/local",
        "work_branch_prefix": "jea/my-subject/work",
        "test_command": "npm test",
        "run_command": "npm start",
        "github_repo": "owner/repo"
      },
      "channels": {
        "presence": {
          "enabled": true,
          "planner": "llm",
          "default_transport": "desktop",
          "default_target": "desktop:main",
          "max_actions_per_tick": 2,
          "cooldown_ms": 1800000,
          "max_messages_per_hour": 8,
          "decision_timeout_ms": 30000,
          "speech_generation_timeout_ms": 25000,
          "llm": {
            "timeout": 25,
            "thinking": "low"
          }
        },
        "desktop": {
          "enabled": true,
          "default_session": "main"
        },
        "feishu": {
          "enabled": true,
          "app_id_env": "JEA_CHANNEL_FEISHU_APP_ID",
          "app_secret_env": "JEA_CHANNEL_FEISHU_APP_SECRET",
          "domain": "feishu",
          "connect_timeout_ms": 20000,
          "send_timeout_ms": 30000,
          "stop_timeout_ms": 5000,
          "shutdown_grace_ms": 10000,
          "retry_base_ms": 5000,
          "retry_multiplier": 2,
          "retry_max_ms": 300000,
          "retry_jitter": 0.2,
          "dm_policy": "allowlist",
          "allow_from": [],
          "group_policy": "disabled",
          "require_mention": false,
          "receipt_reaction": true,
          "receipt_reaction_emoji": "OK",
          "bind": {
            "enabled": true,
            "phrase": "JEA BIND",
            "token_env": "JEA_CHANNEL_FEISHU_BIND_TOKEN"
          }
        }
      },
      "resources": {
        "items": {
          "target_repo": {
            "kind": "repo",
            "handle": "link:my-target-project",
            "note": "Target project repository used as this subject's lane and external write scope.",
            "fallback": "Pause lane writes and inspect the repository manually."
          }
        },
        "roots": {
          "target_repo": "target_repo"
        },
        "aliases": {
          "target_project": "target_repo"
        },
        "rules": [
          {
            "kind": "target_project",
            "scope": "target_project",
            "patterns": [
              "src/**",
              "test/**"
            ]
          }
        ]
      }
    }
  }
}
