{
  "default_subject": "my-subject",
  "subjects": {
    "my-subject": {
      "policy": "subjects/my-subject.md",
      "data_namespace": "my-subject",
      "evolution": {
        "mode": "on_demand"
      },
      "lane": {
        "repo": "D:\\path\\to\\target-project",
        "base_branch": "main",
        "lane_branch": "jea/my-subject/local",
        "work_branch_prefix": "jea/my-subject/work",
        "test_command": "npm test",
        "run_command": "npm start",
        "github_repo": "owner/repo"
      },
      "channels": {
        "feishu": {
          "enabled": true,
          "app_id": "cli_xxxx",
          "app_secret_env": "FEISHU_MY_SUBJECT_APP_SECRET",
          "domain": "feishu",
          "dm_policy": "allowlist",
          "allow_from": [],
          "group_policy": "disabled",
          "require_mention": false,
          "bind": {
            "enabled": true,
            "phrase": "JEA BIND",
            "token_env": "JEA_CHANNEL_FEISHU_MY_SUBJECT_BIND_TOKEN"
          }
        }
      },
      "resources": {
        "items": {
          "target_repo": {
            "kind": "repo",
            "handle": "D:\\path\\to\\target-project",
            "note": "Target project repository used as this subject's lane and external write scope.",
            "fallback": "Pause lane writes and inspect the repository manually."
          }
        },
        "roots": {
          "target_repo": "target_repo"
        },
        "aliases": {
          "target_project": "target_repo"
        },
        "rules": [
          {
            "kind": "target_project",
            "scope": "target_project",
            "patterns": [
              "src/**",
              "test/**"
            ]
          }
        ]
      }
    }
  }
}
